{
  "open-payments-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|grep_search|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/payments-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
